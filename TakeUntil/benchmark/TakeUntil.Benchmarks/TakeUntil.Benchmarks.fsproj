    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\TakeUntil\TakeUntil.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Benchmarks.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
</Project>